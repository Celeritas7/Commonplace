flowchart TB
  %% Fixture design flow using groups as swimlanes, plus several node shapes
  subgraph IN [Inputs]
    direction LR
    I1[/Part 3D data/] ~~~ I2[/Process sheet/] ~~~ I3[/Cycle-time target/]
  end
  subgraph DES [Fixture design]
    D1[[Concept: locating & clamping]] --> D2{3-2-1 locating<br/>constraint OK?}
    D2 -- No --> D1
    D2 -- Yes --> D3[Detail design in Creo]
    D3 --> D4{{Interference & reach check}}
  end
  subgraph REV [Review]
    R1{Design review<br/>approved?}
  end
  subgraph OUT [Release]
    O1[(PDM / Windchill)]
    O2[Order parts & build]
  end
  IN --> D1
  D4 --> R1
  R1 -- Comments --> D3
  R1 ==>|Approved| O1
  O1 --> O2
  style R1 fill:#fef0c7,stroke:#dc6803
  linkStyle default stroke:#475467
