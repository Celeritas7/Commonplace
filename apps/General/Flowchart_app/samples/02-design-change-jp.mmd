flowchart LR
  %% 設計変更フロー（日本語ラベルのサンプル）
  subgraph CUS [顧客]
    R([設計変更依頼])
  end
  subgraph DES [設計]
    A[依頼内容の確認] --> B{影響範囲あり?}
    B -- あり --> C[関連部品の洗い出し]
    B -- なし --> D[3Dモデル修正]
    C --> D
    D --> E[図面修正・出図]
  end
  subgraph CHK [検図]
    F{検図OK?}
  end
  subgraph MFG [生産技術]
    G[治具・工程への反映]
  end
  R --> A
  E --> F
  F -- NG --> D
  F -- OK --> G
  G --> H([完了])
  classDef ng fill:#fee4e2,stroke:#d92d20,color:#7a271a
  classDef done fill:#d1fadf,stroke:#039855,color:#054f31
  class H done
